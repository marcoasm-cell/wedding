<% content_for :title, "Muito obrigado! · Andreia & Marco" %>

<div class="relative min-h-screen overflow-hidden">
  <%= render "shared/foliage", css_class: "pointer-events-none absolute -top-10 -left-10 w-52 rotate-180 opacity-90 sm:w-72" %>
  <%= render "shared/foliage", css_class: "pointer-events-none absolute -bottom-10 -right-10 w-52 opacity-90 sm:w-72" %>

  <main class="relative mx-auto flex min-h-screen w-full max-w-md flex-col items-center justify-center px-6 py-14 text-center">
    <svg class="h-12 w-12 text-sage-600" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z"/>
    </svg>

    <h1 class="mt-6 font-script text-5xl sm:text-6xl">Muito obrigado!</h1>

    <p class="mx-auto mt-6 max-w-xs text-lg italic leading-relaxed text-ink/80">
      <% if @count.positive? %>
        <%= @count == 1 ? "A vossa fotografia foi enviada" : "As vossas #{@count} fotografias foram enviadas" %> com sucesso.
      <% else %>
        As vossas fotografias foram enviadas com sucesso.
      <% end %>
      Ficamos muito felizes por guardarem este dia connosco!
    </p>

    <%= link_to "Enviar mais fotografias", root_path,
          class: "mt-10 inline-block rounded-full border border-sage-600 px-8 py-4 text-sm uppercase tracking-[0.3em] text-sage-700 transition hover:bg-sage-600 hover:text-white" %>

    <p class="mt-12 font-script text-2xl text-sage-700">Andreia &amp; Marco · 05.09.2026</p>
  </main>
</div>
