<% content_for :title, "Andreia & Marco · Partilhem as vossas fotografias" %>

<div class="relative min-h-screen overflow-hidden">
  <%= render "shared/foliage", css_class: "pointer-events-none absolute -top-10 -left-10 w-52 rotate-180 opacity-90 sm:w-72" %>
  <%= render "shared/foliage", css_class: "pointer-events-none absolute -bottom-10 -right-10 w-52 opacity-90 sm:w-72" %>

  <main class="relative mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-6 py-14 text-center">
    <p class="text-[0.65rem] uppercase tracking-[0.35em] text-sage-700">Bem-vindos ao nosso casamento</p>

    <h1 class="mt-6 font-script text-6xl leading-tight sm:text-7xl">
      Andreia
      <span class="block text-4xl sm:text-5xl">e</span>
      Marco
    </h1>

    <div class="mt-8 flex items-center justify-center gap-4 text-2xl tracking-[0.3em] text-ink/80">
      <span>05</span>
      <span class="h-8 w-px bg-sage-400"></span>
      <span>09</span>
      <span class="h-8 w-px bg-sage-400"></span>
      <span>2026</span>
    </div>

    <p class="mx-auto mt-8 max-w-xs text-lg italic leading-relaxed text-ink/80">
      Partilhem connosco os momentos que fotografaram neste dia tão especial!
    </p>

    <%= form_with url: photos_upload_path, multipart: true, data: { controller: "upload", turbo: false, action: "submit->upload#submitting" }, class: "mt-10 space-y-6" do |f| %>
      <div class="text-left">
        <%= f.label :guest_name, "O vosso nome (opcional)", class: "block text-[0.65rem] uppercase tracking-[0.25em] text-sage-700" %>
        <%= f.text_field :guest_name, autocomplete: "name", placeholder: "Ex.: Família Silva",
              class: "mt-2 w-full border-0 border-b border-sage-300 bg-transparent px-1 py-2 text-lg italic placeholder:text-ink/30 focus:border-sage-600 focus:outline-none focus:ring-0" %>
      </div>

      <div class="rounded-2xl border-2 border-dashed border-sage-400 bg-white/50 px-4 py-6">
        <div class="grid grid-cols-2 gap-3">
          <label class="flex cursor-pointer flex-col items-center gap-2 rounded-xl border border-sage-300 bg-white/70 px-3 py-6 text-sage-700 transition hover:bg-sage-100">
            <%= f.file_field :images, multiple: true, accept: "image/*", capture: "environment", id: "camera_input", class: "hidden",
                  data: { upload_target: "input", action: "change->upload#update" } %>
            <svg class="h-8 w-8 text-sage-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z"/>
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0z"/>
            </svg>
            <span class="text-sm">Tirar fotografia</span>
          </label>

          <label class="flex cursor-pointer flex-col items-center gap-2 rounded-xl border border-sage-300 bg-white/70 px-3 py-6 text-sage-700 transition hover:bg-sage-100">
            <%= f.file_field :images, multiple: true, accept: "image/*", id: "gallery_input", class: "hidden",
                  data: { upload_target: "input", action: "change->upload#update" } %>
            <svg class="h-8 w-8 text-sage-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M18 8.25h.008v.008H18V8.25zm2.25 10.5H3.75A1.5 1.5 0 012.25 17.25V6.75A1.5 1.5 0 013.75 5.25h16.5a1.5 1.5 0 011.5 1.5v10.5a1.5 1.5 0 01-1.5 1.5z"/>
            </svg>
            <span class="text-sm">Escolher da galeria</span>
          </label>
        </div>

        <span class="mt-4 block text-sm" data-upload-target="prompt">Tirem uma fotografia ou escolham da galeria</span>
        <span class="mt-4 hidden text-sm text-sage-700" data-upload-target="count"></span>
      </div>

      <div class="hidden grid-cols-4 gap-2" data-upload-target="previews"></div>

      <button type="submit" disabled data-upload-target="submit"
              class="w-full rounded-full bg-sage-600 px-8 py-4 text-sm uppercase tracking-[0.3em] text-white shadow-md transition enabled:hover:bg-sage-700 disabled:cursor-not-allowed disabled:opacity-40">
        <span data-upload-target="submitLabel">Enviar fotografias</span>
      </button>
    <% end %>

    <p class="mt-12 font-script text-2xl text-sage-700">Com amor, Andreia &amp; Marco</p>
  </main>
</div>
