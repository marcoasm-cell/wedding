<% content_for :title, "Administração · Andreia & Marco" %>

<div class="relative min-h-screen overflow-hidden">
  <%= render "shared/foliage", css_class: "pointer-events-none absolute -top-10 -left-10 w-48 rotate-180 opacity-80 sm:w-64" %>
  <%= render "shared/foliage", css_class: "pointer-events-none absolute -bottom-10 -right-10 w-48 opacity-80 sm:w-64" %>

  <main class="relative mx-auto flex min-h-screen w-full max-w-sm flex-col justify-center px-6 py-14">
    <div class="text-center">
      <p class="text-[0.65rem] uppercase tracking-[0.35em] text-sage-700">Área de administração</p>
      <h1 class="mt-4 font-script text-5xl">Andreia <span class="text-3xl">e</span> Marco</h1>
    </div>

    <%= form_with url: admin_login_path, method: :post, class: "mt-12 space-y-6" do |f| %>
      <div>
        <%= f.label :email, "Email", class: "block text-[0.65rem] uppercase tracking-[0.25em] text-sage-700" %>
        <%= f.email_field :email, required: true, autofocus: true, autocomplete: "username",
              class: "mt-2 w-full border-0 border-b border-sage-300 bg-transparent px-1 py-2 text-lg focus:border-sage-600 focus:outline-none focus:ring-0" %>
      </div>

      <div>
        <%= f.label :password, "Palavra-passe", class: "block text-[0.65rem] uppercase tracking-[0.25em] text-sage-700" %>
        <%= f.password_field :password, required: true, autocomplete: "current-password",
              class: "mt-2 w-full border-0 border-b border-sage-300 bg-transparent px-1 py-2 text-lg focus:border-sage-600 focus:outline-none focus:ring-0" %>
      </div>

      <button type="submit"
              class="w-full rounded-full bg-sage-600 px-8 py-4 text-sm uppercase tracking-[0.3em] text-white shadow-md transition hover:bg-sage-700">
        Entrar
      </button>
    <% end %>
  </main>
</div>
